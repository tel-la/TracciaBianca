# Riferimenti locali
/§§_REF/

# Aree operative, dati condivisi e cache: esclusi per default
/##_aree/*

# Indice e configurazione portabile del template
!/##_aree/README.txt
!/##_aree/00_template-area/
/##_aree/00_template-area/*
!/##_aree/00_template-area/area.json

# Piccola allowlist dell'archivio comune; tutto il resto rimane locale
!/##_aree/_archivio_comune/
/##_aree/_archivio_comune/*

!/##_aree/_archivio_comune/dtm/
/##_aree/_archivio_comune/dtm/*
!/##_aree/_archivio_comune/dtm/coperture/
!/##_aree/_archivio_comune/dtm/coperture/*.geojson
!/##_aree/_archivio_comune/dtm/coperture/README.md

!/##_aree/_archivio_comune/osm/
/##_aree/_archivio_comune/osm/*
!/##_aree/_archivio_comune/osm/osmconf_scialpinismo.ini
!/##_aree/_archivio_comune/osm/LEGGIMI_PROVENIENZA_E_LICENZE.txt

# Configurazioni e registri territoriali mai versionati
/##_aree/**/area.json
/##_aree/**/fonti.json
!/##_aree/00_template-area/area.json

# Materiale preparatorio per future release di mappe
/release_staging/

# Le allowlist di directory non devono riattivare spazzatura locale o cache
.DS_Store
__pycache__/
*.py[cod]
